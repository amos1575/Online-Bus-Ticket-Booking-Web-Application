@page "{scheduleId:int}"
@model Online_Bus_Ticket_Booking_Web_Application.Pages.Booking.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>
<p class="text-muted">
    @Model.Origin &rarr; @Model.Destination &middot; @Model.DepartureTime.ToString("ddd, dd MMM yyyy HH:mm")
</p>

@if (Model.EarliestExpiry is not null)
{
    <div class="alert alert-warning">
        Your seats are held until <strong>@Model.EarliestExpiry.Value.ToString("HH:mm:ss") UTC</strong>. Complete payment before then or your seats will be released.
    </div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <input type="hidden" name="scheduleId" value="@Model.ScheduleId" />

    <h5>Passenger details</h5>
    <table class="table">
        <thead>
            <tr>
                <th>Seat</th>
                <th>Passenger name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hold in Model.Holds)
            {
                <tr>
                    <td class="align-middle">@hold.Seat.SeatNumber</td>
                    <td>
                        <input class="form-control" name="passengerNames[@hold.SeatId]" required placeholder="Full name" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h5>Payment</h5>
    <p>Total amount: <strong>@Model.TotalAmount.ToString("C")</strong></p>

    <div class="mb-3">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="method" id="method-card" value="Card" checked />
            <label class="form-check-label" for="method-card">Card</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="method" id="method-mobile" value="MobileMoney" />
            <label class="form-check-label" for="method-mobile">Mobile Money</label>
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="simulateFailure" value="true" id="simulateFailure" />
        <label class="form-check-label" for="simulateFailure">Simulate a declined payment (demo)</label>
    </div>

    <p class="text-muted"><small>This is a simulated payment gateway for demo purposes &mdash; no real charge is made.</small></p>

    <button type="submit" class="btn btn-primary btn-lg">Pay Now</button>
</form>
