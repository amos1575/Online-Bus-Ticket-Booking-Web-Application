@page
@model Online_Bus_Ticket_Booking_Web_Application.Pages.Admin.Bookings.IndexModel
@{
    ViewData["Title"] = "All Bookings";
}

<h1>Bookings</h1>

<form method="get" class="row g-2 mb-3" style="max-width: 32rem;">
    <div class="col-8">
        <input class="form-control" asp-for="Query" placeholder="Search by passenger name, email, or ticket code" />
    </div>
    <div class="col-4">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>

<table class="table">
    <thead><tr><th>Booking</th><th>Passenger</th><th>Route</th><th>Departure</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var booking in Model.Bookings)
        {
            <tr>
                <td>BK-@booking.BookingId.ToString("D6")</td>
                <td>@booking.User.FullName</td>
                <td>@booking.Schedule.Route.Origin &rarr; @booking.Schedule.Route.Destination</td>
                <td>@booking.Schedule.DepartureTime.ToString("ddd, dd MMM yyyy HH:mm")</td>
                <td>@booking.TotalAmount.ToString("C")</td>
                <td>@booking.Status</td>
                <td><a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Bookings/Details" asp-route-id="@booking.BookingId">Details</a></td>
            </tr>
        }
    </tbody>
</table>
