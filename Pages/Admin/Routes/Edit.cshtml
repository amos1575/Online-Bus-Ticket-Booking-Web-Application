@page "{id:int}"
@model Online_Bus_Ticket_Booking_Web_Application.Pages.Admin.Routes.EditModel
@{
    ViewData["Title"] = "Edit Route";
}

<h1>Edit route</h1>

<form method="post" class="row g-3" style="max-width: 32rem;">
    <input type="hidden" asp-for="Input.RouteId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="col-12">
        <label class="form-label" asp-for="Input.Origin"></label>
        <input class="form-control" asp-for="Input.Origin" />
    </div>
    <div class="col-12">
        <label class="form-label" asp-for="Input.Destination"></label>
        <input class="form-control" asp-for="Input.Destination" />
    </div>
    <div class="col-12">
        <label class="form-label" asp-for="Input.DistanceKm"></label>
        <input class="form-control" asp-for="Input.DistanceKm" type="number" step="0.1" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Routes/Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
